{
  "name": "applyforme",
  "version": "2.0.0",
  "private": true,
  "description": "ApplyForMe v2 — reads Seek job alerts, tailors a CV and cover letter with Claude, emails the pack for review. Deterministic engine + Next.js on Cloudflare Workers.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "dev": "npm run dev -w @applyforme/web",
    "build": "npm run build -w @applyforme/web",
    "deploy": "npm run deploy -w @applyforme/web"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
