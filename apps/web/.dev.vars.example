# Copy to .dev.vars for local `next dev` / `wrangler dev`. Never commit .dev.vars.
ANTHROPIC_API_KEY=
TOKENS_ENC_KEY=
ACTION_LINK_SECRET=
# Empty locally overrides the fail-closed placeholders in wrangler.jsonc vars, so
# identity falls back to user 1 (dev-mode escape hatch). Never set these empty in prod.
ACCESS_TEAM_DOMAIN=
ACCESS_APP_AUD=
