# Required
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# OAuth — Microsoft (optional)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common

# OAuth — Google (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WebAuthn
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=ApplyForMe
WEBAUTHN_ORIGIN=http://localhost:3000

# Email — SMTP (optional, console output if not set)
EMAIL_SERVER=smtp://user:pass@smtp.gmail.com:587
EMAIL_FROM=noreply@yourdomain.com

# Database — for cloud, use PostgreSQL and update prisma schema
# DATABASE_URL=postgresql://user:pass@host:5432/applyforme
